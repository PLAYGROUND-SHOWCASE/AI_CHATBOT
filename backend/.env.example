# ZARVIS Environment Configuration
APP_ENV=development
APP_NAME=ZARVIS
APP_VERSION=1.0.0
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Database
DATABASE_URL=postgresql+asyncpg://zarvis:zarvis@localhost:5432/zarvis

# Redis (optional - for rate limiting / caching)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-jwt-secret-long-random
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=50

# Voice
VOICE_ENABLED=true
WAKE_WORD_ENABLED=false
WAKE_WORD=hey zarvis

# TTS Provider (browser | google | elevenlabs)
TTS_PROVIDER=browser

# STT Provider (browser | google | whisper)
STT_PROVIDER=browser

# Debug
DEBUG=true
LOG_LEVEL=INFO
